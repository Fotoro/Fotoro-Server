{
  "name": "fotoro-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "Fotoro — self-hosted, intelligent photo & video archive. Go backend + Next.js site.",
  "scripts": {
    "dev": "npm --prefix site run dev",
    "build": "npm --prefix site run build",
    "start": "npm --prefix site run start",
    "lint": "npm --prefix site run lint",
    "typecheck": "npm --prefix site run typecheck",
    "install:site": "npm --prefix site install",
    "postinstall": "if [ -z \"$CI\" ]; then husky install; fi",
    "server": "go run .",
    "server:build": "go build -o bin/fotoro ."
  }
}
