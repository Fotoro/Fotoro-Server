# ── Supabase (Dashboard → Settings → API) ─────────────────────────────
# Project URL
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# anon / publishable key (safe for browser — NOT used by /api/auth/verify)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...anon...

# service_role key (SECRET — server only, never commit or expose to browser)
# ⚠️  Do NOT paste the anon key here. Copy "service_role" from Supabase API settings.
SUPABASE_SERVICE_KEY=eyJ...service_role...

# ── Google (Cloud Console → Credentials → OAuth 2.0 Web client) ───────
NEXT_PUBLIC_GOOGLE_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com

# Also required in Supabase → Authentication → URL Configuration:
#   Redirect URLs: http://localhost:3000/auth/callback
#                  https://fotoro.vercel.app/auth/callback
#                  https://fotoro.app/auth/callback

# ── Optional legacy NextAuth ──────────────────────────────────────────
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
